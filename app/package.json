{
  "name": "devops-observability-app",
  "version": "1.0.0",
  "description": "Sample Node.js Express app instrumented with Prometheus metrics, Winston JSON logging, Loki log streaming, and OpenTelemetry Jaeger tracing",
  "main": "server.js",
  "scripts": {
    "start": "node -r ./tracing.js server.js",
    "test": "node --test",
    "lint": "node --check server.js && node --check tracing.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.48.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.1",
    "@opentelemetry/sdk-node": "^0.52.1",
    "express": "^4.19.2",
    "prom-client": "^15.1.3",
    "winston": "^3.13.0",
    "winston-loki": "^6.1.3"
  }
}
