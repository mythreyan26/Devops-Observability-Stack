# ==============================================================================
# DevOps Observability Stack - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env (Linux/macOS)
#   Copy-Item .env.example .env (PowerShell)
#
# NOTE: .env is git-ignored to prevent credential leaks.
# ==============================================================================

# --- Grafana Security Credentials ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Application Configuration ---
NODE_ENV=production
APP_PORT=3000
OTEL_SERVICE_NAME=nodejs-demo-app

# --- Port Bindings (Host Ports) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=4318
